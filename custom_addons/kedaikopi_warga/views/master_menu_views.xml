<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_menu_item_kanban" model="ir.ui.view">
        <field name="name">menu.item.kanban</field>
        <field name="model">kedaikopi.menu_item</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile kkw-shell kkw-menu-kanban" sample="1">
                <field name="name"/>
                <field name="id_kategori"/>
                <field name="harga"/>
                <field name="status_tersedia"/>
                <field name="currency_id" invisible="1"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click kkw-menu-card mb-3 p-3" style="background: linear-gradient(145deg, #ffffff 0%, #f3f8f6 100%); border: 1px solid #d7e2de; border-radius: 14px; box-shadow: 0 10px 22px rgba(18, 59, 51, 0.08);">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <strong class="fs-5 text-dark"><field name="name"/></strong>
                                    <div class="text-muted small mt-1 text-uppercase">
                                        <i class="fa fa-tag me-1"/>Kategori: <field name="id_kategori"/>
                                    </div>
                                </div>
                                <span class="kkw-price-pill">
                                    <field name="harga" widget="monetary"/>
                                </span>
                            </div>
                            <hr class="text-muted opacity-25 my-2"/>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div>
                                    <span t-if="record.status_tersedia.raw_value" class="kkw-chip is-success"><i class="fa fa-check-circle"/>Tersedia</span>
                                    <span t-if="!record.status_tersedia.raw_value" class="kkw-chip is-danger"><i class="fa fa-times-circle"/>Habis</span>
                                </div>
                                <field name="status_tersedia" widget="boolean_toggle"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_menu_item_form" model="ir.ui.view">
        <field name="name">menu.item.form</field>
        <field name="model">kedaikopi.menu_item</field>
        <field name="arch" type="xml">
            <form string="Detail Menu" class="kkw-shell">
                <header>
                    <button name="updateMenu" string="Simpan Perubahan" type="object" class="btn-primary oe_highlight" icon="fa-save"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Habis" bg_color="text-bg-danger" invisible="status_tersedia == True"/>
                    <div class="oe_title mb-3" style="background: linear-gradient(120deg, #f4faf8 0%, #ffffff 100%); border: 1px solid #dce8e4; border-radius: 12px; padding: 14px 16px;">
                        <p class="kkw-eyebrow">Master Produk</p>
                        <h1 class="kkw-title"><field name="name" placeholder="Misal: Kopi Susu Warga"/></h1>
                        <p class="kkw-subtitle">Perbarui kategori, harga, dan ketersediaan menu dari satu halaman yang ringkas.</p>
                    </div>

                    <div class="kkw-metric-grid">
                        <div class="kkw-metric-card" style="background: #ffffff; border: 1px solid #d7e5e0; border-radius: 12px; box-shadow: 0 8px 16px rgba(19, 62, 54, 0.07);">
                            <h6>Harga Saat Ini</h6>
                            <field name="currency_id" invisible="1"/>
                            <h3><field name="harga" widget="monetary" nolabel="1"/></h3>
                        </div>
                        <div class="kkw-metric-card" style="background: #ffffff; border: 1px solid #d7e5e0; border-radius: 12px; box-shadow: 0 8px 16px rgba(19, 62, 54, 0.07);">
                            <h6>Status Ketersediaan</h6>
                            <h3 invisible="status_tersedia == False">Tersedia</h3>
                            <h3 invisible="status_tersedia == True">Habis</h3>
                        </div>
                    </div>

                    <group class="kkw-panel" style="border: 1px solid #d8e4e1; border-radius: 12px; padding: 10px; background: #ffffff;">
                        <group string="Detail Harga &amp; Kategori">
                            <field name="id_kategori" options="{'no_create': True}"/>
                            <field name="harga" widget="monetary"/>
                        </group>
                        <group string="Ketersediaan Operasional">
                            <field name="status_tersedia" widget="boolean_toggle"/>
                            <field name="varian" placeholder="Misal: Panas, Dingin, atau Less Sugar"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kedaikopi_menu" model="ir.actions.act_window">
        <field name="name">Master Menu Produk</field>
        <field name="res_model">kedaikopi.menu_item</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
    <menuitem id="menu_master_menu" name="Master Menu" parent="menu_ops_category" action="action_kedaikopi_menu" sequence="2"/>
</odoo>